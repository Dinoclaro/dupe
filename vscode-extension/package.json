{
  "name": "dupe-studio",
  "displayName": "dupe Research Studio",
  "description": "Explorer-integrated paper library, Obsidian-style notes & lists, citation intelligence, SyncTeX PDF reader, and Overleaf sync backed by the local dupe daemon.",
  "version": "0.4.6",
  "publisher": "dinoclaro",
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Spell checking, citation autocomplete, notes, and local PDF preview work in Restricted Mode; trust the project folder for full workspace features."
    }
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run"
  },
  "contributes": {
    "configuration": {
      "title": "dupe Research Studio",
      "properties": {
        "dupe.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8080",
          "description": "Base URL of the local dupe daemon (or hosted dupe server)."
        },
        "dupe.authToken": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token when connecting to a hosted dupe server."
        },
        "dupe.openPdfOnCompile": {
          "type": "boolean",
          "default": true,
          "description": "Open or refresh the compiled PDF preview tab after compiling LaTeX."
        },
        "dupe.compileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically recompile project LaTeX when saving a .tex file inside paper/."
        },
        "dupe.spellCheck.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable offline LaTeX and Markdown spell checking with quick fixes."
        },
        "dupe.spellCheck.dialect": {
          "type": "string",
          "enum": [
            "en-US",
            "en-GB"
          ],
          "default": "en-US",
          "description": "English spelling dictionary dialect."
        },
        "dupe.spellCheck.extraWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "User dictionary words ignored by the dupe spell checker."
        },
        "dupe.commentTargetNote": {
          "type": "string",
          "default": "notes/comments.md",
          "description": "Project note file where inline selection comments are appended (e.g. notes/comments.md or notes/paperChanges.md)."
        },
        "dupe.autoCheckUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check GitHub Releases for dupe and dupe-studio updates."
        },
        "dupe.herdr.followSpace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically collapse inactive project folders in VS Code Explorer and expand/focus the project matching your active Herdr space."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "dupe.notesView",
          "name": "dupe: Brain & Links"
        },
        {
          "id": "dupe.papersView",
          "name": "dupe: Paper Library"
        },
        {
          "id": "dupe.projectView",
          "name": "dupe: Project & Sync"
        }
      ]
    },
    "commands": [
      {
        "command": "dupe.refresh",
        "title": "dupe: Refresh Library & Project",
        "icon": "$(refresh)"
      },
      {
        "command": "dupe.quickOpenNote",
        "title": "dupe: Quick Switcher (Notes & LaTeX)",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dupe.openLatestArtifact",
        "title": "dupe: Open Agent Artifact (Preview)",
        "icon": "$(sparkle)"
      },
      {
        "command": "dupe.dailyNote",
        "title": "dupe: Open Today's Daily Note",
        "icon": "$(calendar)"
      },
      {
        "command": "dupe.newNote",
        "title": "dupe: New Note in notes/",
        "icon": "$(new-file)"
      },
      {
        "command": "dupe.renameNote",
        "title": "dupe: Rename Note",
        "icon": "$(edit)"
      },
      {
        "command": "dupe.deleteNote",
        "title": "dupe: Delete Note",
        "icon": "$(trash)"
      },
      {
        "command": "dupe.markdownEnter",
        "title": "dupe: Obsidian List Continuation on Enter"
      },
      {
        "command": "dupe.toggleCheckbox",
        "title": "dupe: Toggle Markdown Checkbox"
      },
      {
        "command": "dupe.quickInsertLink",
        "title": "dupe: Insert Wikilink / Citation",
        "icon": "$(quote)"
      },
      {
        "command": "dupe.formatBold",
        "title": "dupe: Toggle Bold (** / \\textbf)"
      },
      {
        "command": "dupe.formatItalic",
        "title": "dupe: Toggle Italic (* / \\textit)"
      },
      {
        "command": "dupe.searchByTag",
        "title": "dupe: Browse Notes by #tag",
        "icon": "$(tag)"
      },
      {
        "command": "dupe.openOrCreateWikiLink",
        "title": "dupe: Open or Create Wiki Link"
      },
      {
        "command": "dupe.searchPapers",
        "title": "dupe: Search Papers",
        "icon": "$(search)"
      },
      {
        "command": "dupe.clearPaperFilter",
        "title": "dupe: Clear Paper Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "dupe.addPaper",
        "title": "dupe: Add Paper (URL / arXiv / DOI / PDF)",
        "icon": "$(add)"
      },
      {
        "command": "dupe.importPaperUrl",
        "title": "dupe: Import Paper from URL / arXiv / DOI",
        "icon": "$(link)"
      },
      {
        "command": "dupe.uploadPdf",
        "title": "dupe: Upload PDF File(s) from Disk",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "dupe.syncLibrary",
        "title": "dupe: Sync Paper Library with Hosted Server",
        "icon": "$(repo-sync)"
      },
      {
        "command": "dupe.openPaperPdf",
        "title": "dupe: Open Paper PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "dupe.openPaperByKey",
        "title": "dupe: Open Paper PDF by BibTeX Key"
      },
      {
        "command": "dupe.insertCitation",
        "title": "dupe: Insert Citation at Cursor",
        "icon": "$(quote)"
      },
      {
        "command": "dupe.copyBibtex",
        "title": "dupe: Copy BibTeX Entry",
        "icon": "$(copy)"
      },
      {
        "command": "dupe.toggleLinkPaper",
        "title": "dupe: Link / Unlink Paper in Project",
        "icon": "$(link)"
      },
      {
        "command": "dupe.deletePaper",
        "title": "dupe: Delete Paper from Library",
        "icon": "$(trash)"
      },
      {
        "command": "dupe.compileLatex",
        "title": "dupe: Compile Project LaTeX",
        "icon": "$(play)"
      },
      {
        "command": "dupe.openCompiledPdf",
        "title": "dupe: Open Compiled Paper PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "dupe.syncTexForward",
        "title": "dupe: Jump from Cursor to PDF (SyncTeX Forward)",
        "icon": "$(arrow-right)"
      },
      {
        "command": "dupe.pullProject",
        "title": "dupe: Pull Overleaf Remote",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dupe.syncProject",
        "title": "dupe: Commit & Push Project (Overleaf Sync)",
        "icon": "$(sync)"
      },
      {
        "command": "dupe.gatherContext",
        "title": "dupe: Regenerate AGENTS.md & BibTeX",
        "icon": "$(sparkle)"
      },
      {
        "command": "dupe.createProject",
        "title": "dupe: New Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "dupe.switchProjectsRoot",
        "title": "dupe: Switch Projects Parent Folder",
        "icon": "$(folder-library)"
      },
      {
        "command": "dupe.openProjectFolder",
        "title": "dupe: Open Project in New Window",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dupe.switchProjectWindow",
        "title": "dupe: Open Any Project in New Window",
        "icon": "$(window)"
      },
      {
        "command": "dupe.linkLocalFolder",
        "title": "dupe: Link Code or LaTeX Repo (Subdirectory Symlink)",
        "icon": "$(file-symlink-directory)"
      },
      {
        "command": "dupe.openWebUI",
        "title": "dupe: Open Web UI in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "dupe.toggleSpellCheck",
        "title": "dupe: Toggle Spell Check",
        "icon": "$(check)"
      },
      {
        "command": "dupe.addWordToProjectDict",
        "title": "dupe: Add Word to Project Dictionary"
      },
      {
        "command": "dupe.addWordToUserDict",
        "title": "dupe: Add Word to User Dictionary"
      },
      {
        "command": "dupe.addComment",
        "title": "dupe: Add Comment on Selection",
        "icon": "$(comment)"
      },
      {
        "command": "dupe.selectCommentTarget",
        "title": "dupe: Select Comment Target Note",
        "icon": "$(list-selection)"
      },
      {
        "command": "dupe.checkUpdates",
        "title": "dupe: Check for Updates",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dupe.openAllProjectsWorkspace",
        "title": "dupe: Open All Projects in One Window",
        "icon": "$(root-folder-opened)"
      },
      {
        "command": "dupe.syncWithHerdrNow",
        "title": "dupe: Focus Active Herdr Space Project",
        "icon": "$(layers)"
      },
      {
        "command": "dupe.toggleHerdrFollow",
        "title": "dupe: Toggle Follow Herdr Space",
        "icon": "$(eye)"
      },
      {
        "command": "dupe.openKnowledgeGraph",
        "title": "dupe: Open Brain Studio & Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dupe.openInBrainStudio",
        "title": "dupe: Open Note in Brain Studio Reader",
        "icon": "$(book)"
      },
      {
        "command": "dupe.openAgentBlackboard",
        "title": "dupe: Open Agent Blackboard (.dupe/brain)",
        "icon": "$(hubot)"
      }
    ],
    "keybindings": [
      {
        "command": "dupe.quickOpenNote",
        "key": "alt+o"
      },
      {
        "command": "dupe.newNote",
        "key": "alt+n"
      },
      {
        "command": "dupe.dailyNote",
        "key": "alt+d"
      },
      {
        "command": "dupe.searchByTag",
        "key": "alt+t"
      },
      {
        "command": "dupe.markdownEnter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == markdown && !suggestWidgetVisible && !inlineSuggestionVisible && !parameterHintsVisible"
      },
      {
        "command": "dupe.toggleCheckbox",
        "key": "ctrl+enter",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "dupe.quickInsertLink",
        "key": "alt+l",
        "when": "editorTextFocus && (editorLangId == markdown || editorLangId == latex || editorLangId == tex)"
      },
      {
        "command": "dupe.formatBold",
        "key": "alt+b",
        "when": "editorTextFocus && (editorLangId == markdown || editorLangId == latex || editorLangId == tex)"
      },
      {
        "command": "dupe.formatItalic",
        "key": "alt+i",
        "when": "editorTextFocus && (editorLangId == markdown || editorLangId == latex || editorLangId == tex)"
      },
      {
        "command": "dupe.syncTexForward",
        "key": "alt+j",
        "when": "editorTextFocus && (editorLangId == latex || editorLangId == tex)"
      },
      {
        "command": "dupe.compileLatex",
        "key": "alt+c",
        "when": "editorTextFocus && (editorLangId == latex || editorLangId == tex)"
      },
      {
        "command": "dupe.addComment",
        "key": "alt+shift+c",
        "mac": "ctrl+shift+c",
        "when": "editorTextFocus && (editorLangId == markdown || editorLangId == latex || editorLangId == tex)"
      },
      {
        "command": "dupe.openKnowledgeGraph",
        "key": "alt+g"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dupe.compileLatex",
          "when": "editorLangId == latex || editorLangId == tex",
          "group": "navigation@1"
        },
        {
          "command": "dupe.openCompiledPdf",
          "when": "editorLangId == latex || editorLangId == tex",
          "group": "navigation@2"
        },
        {
          "command": "dupe.syncTexForward",
          "when": "editorLangId == latex || editorLangId == tex",
          "group": "navigation@3"
        },
        {
          "command": "dupe.syncProject",
          "when": "editorLangId == latex || editorLangId == tex",
          "group": "navigation@4"
        },
        {
          "command": "dupe.addComment",
          "when": "editorLangId == latex || editorLangId == tex",
          "group": "navigation@5"
        },
        {
          "command": "dupe.quickOpenNote",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "dupe.newNote",
          "when": "editorLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "dupe.dailyNote",
          "when": "editorLangId == markdown",
          "group": "navigation@3"
        },
        {
          "command": "dupe.quickInsertLink",
          "when": "editorLangId == markdown",
          "group": "navigation@4"
        },
        {
          "command": "dupe.addComment",
          "when": "editorLangId == markdown",
          "group": "navigation@5"
        }
      ],
      "explorer/context": [
        {
          "command": "dupe.newNote",
          "group": "1_dupe@1"
        },
        {
          "command": "dupe.addPaper",
          "group": "1_dupe@2"
        },
        {
          "command": "dupe.compileLatex",
          "group": "1_dupe@3"
        },
        {
          "command": "dupe.syncProject",
          "group": "1_dupe@4"
        }
      ],
      "view/title": [
        {
          "command": "dupe.quickOpenNote",
          "when": "view == dupe.notesView",
          "group": "navigation"
        },
        {
          "command": "dupe.openLatestArtifact",
          "when": "view == dupe.notesView",
          "group": "navigation"
        },
        {
          "command": "dupe.newNote",
          "when": "view == dupe.notesView",
          "group": "navigation"
        },
        {
          "command": "dupe.dailyNote",
          "when": "view == dupe.notesView",
          "group": "navigation"
        },
        {
          "command": "dupe.searchByTag",
          "when": "view == dupe.notesView",
          "group": "navigation"
        },
        {
          "command": "dupe.openKnowledgeGraph",
          "when": "view == dupe.notesView",
          "group": "navigation"
        },
        {
          "command": "dupe.searchPapers",
          "when": "view == dupe.papersView",
          "group": "navigation"
        },
        {
          "command": "dupe.addPaper",
          "when": "view == dupe.papersView",
          "group": "navigation"
        },
        {
          "command": "dupe.syncLibrary",
          "when": "view == dupe.papersView",
          "group": "navigation"
        },
        {
          "command": "dupe.clearPaperFilter",
          "when": "view == dupe.papersView && dupe.hasPaperFilter",
          "group": "navigation"
        },
        {
          "command": "dupe.compileLatex",
          "when": "view == dupe.projectView",
          "group": "navigation"
        },
        {
          "command": "dupe.syncProject",
          "when": "view == dupe.projectView",
          "group": "navigation"
        },
        {
          "command": "dupe.refresh",
          "when": "view == dupe.projectView || view == dupe.papersView || view == dupe.notesView",
          "group": "navigation"
        },
        {
          "command": "dupe.checkUpdates",
          "when": "view == dupe.projectView",
          "group": "9_updates@1"
        },
        {
          "command": "dupe.openAllProjectsWorkspace",
          "when": "view == dupe.projectView",
          "group": "9_updates@2"
        },
        {
          "command": "dupe.toggleHerdrFollow",
          "when": "view == dupe.projectView",
          "group": "9_updates@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dupe.insertCitation",
          "when": "view == dupe.papersView && viewItem =~ /^paper/",
          "group": "inline@1"
        },
        {
          "command": "dupe.openPaperPdf",
          "when": "view == dupe.papersView && viewItem =~ /^paper/",
          "group": "inline@2"
        },
        {
          "command": "dupe.toggleLinkPaper",
          "when": "view == dupe.papersView && viewItem =~ /^paper/",
          "group": "1_actions@1"
        },
        {
          "command": "dupe.copyBibtex",
          "when": "view == dupe.papersView && viewItem =~ /^paper/",
          "group": "1_actions@2"
        },
        {
          "command": "dupe.deletePaper",
          "when": "view == dupe.papersView && viewItem =~ /^paper/",
          "group": "2_danger@1"
        }
      ],
      "editor/context": [
        {
          "command": "dupe.syncTexForward",
          "when": "editorLangId == latex || editorLangId == tex",
          "group": "navigation@1"
        },
        {
          "command": "dupe.compileLatex",
          "when": "editorLangId == latex || editorLangId == tex",
          "group": "navigation@2"
        },
        {
          "command": "dupe.quickInsertLink",
          "when": "editorLangId == markdown || editorLangId == latex || editorLangId == tex",
          "group": "navigation@3"
        },
        {
          "command": "dupe.addComment",
          "when": "editorLangId == markdown || editorLangId == latex || editorLangId == tex",
          "group": "navigation@4"
        }
      ]
    }
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^4.8.69"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
